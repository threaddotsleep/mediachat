PORT=3000

# Add both Cloudflare Turnstile keys to enable content submissions.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Add your AdSense publisher ID (ca-pub- followed by 16 digits) to enable ads.
ADSENSE_PUBLISHER_ID=

# Keep disabled unless a current MaxMind Anonymous IP database is configured.
BLOCK_ANONYMOUS_IPS=false
MAXMIND_ANONYMOUS_IP_DB=

# Set this to the exact number of trusted reverse-proxy hops, if applicable.
TRUST_PROXY_HOPS=0

# Optional storage overrides. Defaults are ./converted and ./converted/audit.
MEDIA_DIRECTORY=
AUDIT_DIRECTORY=